#!/usr/bin/env python3
import json
import sqlite3
from datetime import datetime
from pathlib import Path

DB_PATH = Path("mfl_database.db")  # adjust if needed
OUT_PATH = Path("site/mym_dashboard.json")  # output folder for hosting

MIN_SEASON = 2019

def dict_rows(cur):
    cols = [c[0] for c in cur.description]
    for row in cur.fetchall():
        yield dict(zip(cols, row))

def main():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    cur = conn.cursor()

    # Eligibility rows (history)
    cur.execute(
        """
        SELECT
          season, week, franchise_id, franchise_name, franchise_logo,
          player_id, player_name, position, positional_grouping,
          salary, contract_year, contract_status,
          acquired_date, mym_acq_type, mym_deadline, eligible_flag, rule_explanation
        FROM View_MYM_Eligibility
        WHERE CAST(season AS INTEGER) >= ?
        ORDER BY CAST(season AS INTEGER) DESC, franchise_name, player_name;
        """,
        (MIN_SEASON,),
    )
    eligibility = list(dict_rows(cur))

    # Usage rows (history)
    cur.execute(
        """
        SELECT
          season, franchise_id, team_name, mym_used, mym_remaining
        FROM View_MYM_Usage
        WHERE CAST(season AS INTEGER) >= ?
        ORDER BY CAST(season AS INTEGER) DESC, team_name;
        """,
        (MIN_SEASON,),
    )
    usage = list(dict_rows(cur))

    payload = {
        "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "min_season": MIN_SEASON,
        "eligibility": eligibility,
        "usage": usage,
    }

    OUT_PATH.parent.mkdir(parents=True, exist_ok=True)
    OUT_PATH.write_text(json.dumps(payload, indent=2), encoding="utf-8")

    print(f"✅ Wrote {OUT_PATH} ({len(eligibility)} eligibility rows, {len(usage)} usage rows)")

if __name__ == "__main__":
    main()
